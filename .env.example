# Tavus (server only — never prefix TAVUS_API_KEY with NEXT_PUBLIC_ or VITE_)
TAVUS_API_KEY=
# Full-pipeline PAL id from POST /v2/pals. If empty, stock PAL pcb7a34da5fe is used.
TAVUS_PAL_ID=
# Optional face override. Leave empty to use the PAL default_face_id (Anna r90bbd427f71 on the Interviewer PAL).
TAVUS_FACE_ID=
# Optional shared secret for POST /api/tavus/pal
TAVUS_SETUP_TOKEN=

# Public site URL for JSON-LD and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LiveKit (optional agent worker)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Echo-mode PAL with livekit transport. Do not reuse TAVUS_PAL_ID here.
TAVUS_LIVEKIT_PAL_ID=
